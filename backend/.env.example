# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# --- Keamanan ---
# Wajib minimal 32 karakter acak. Generate dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=mysql+pymysql://root:@localhost:3306/konveksi_simple

# --- Email (SMTP Gmail) ---
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# --- Midtrans (pembayaran) ---
# Sandbox key berawalan "SB-Mid-...", production berawalan "Mid-...".
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- URL & CORS ---
FRONTEND_URL=http://localhost:5173
# Origin yang diizinkan, pisahkan dengan koma. JANGAN pakai "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opsional: batasi Host header (isi domain produksi, mis. example.com).
# ALLOWED_HOSTS=example.com,www.example.com

# --- Rate limiting (multi-worker) ---
# Default memory (single worker saja). Produksi multi-worker WAJIB Redis:
#   REDIS_URL=redis://redis:6379
REDIS_URL=memory://

# --- Security headers (CSP dll.) ---
SECURITY_HEADERS_ENABLED=true
# Aktifkan HSTS HANYA kalau situs sudah benar-benar disajikan lewat HTTPS.
HSTS_ENABLED=false
# Opsional: timpa kebijakan CSP default kalau perlu domain tambahan.
# CSP_POLICY=default-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'
