# Salin file ini menjadi `.env` lalu sesuaikan.
# Vite hanya mengekspos variabel yang berawalan VITE_ ke kode frontend.

# Base URL backend (tanpa trailing slash). Saat produksi ganti ke domain API-mu,
# contoh: https://api.konveksibordir.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# URL Snap.js Midtrans.
# Sandbox (development): https://app.sandbox.midtrans.com/snap/snap.js
# Produksi:               https://app.midtrans.com/snap/snap.js
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Set "true" saat build produksi untuk menyuntikkan <meta Content-Security-Policy>
# ke index.html. Biarkan false saat dev agar HMR tidak terganggu.
CSP_ENABLED=false
